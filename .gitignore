# Arquivos gerados pelo Noctalia a cada troca de esquema de cores.
# As FONTES ficam versionadas: noctalia/templates/, noctalia/scripts/ e
# noctalia/user-templates.toml. Estes aqui são apenas a saída.
foot/themes/noctalia
niri/noctalia.kdl
# Sobra do Noctalia v4 (o v5 não atualiza mais).
noctalia/colors.json

# nvim/lua/noctalia.lua FICA versionado de propósito: deveria ser gerado a
# partir de noctalia/templates/neovim.lua, mas o Noctalia v5 não aplica os
# templates de user-templates.toml (veja noctalia/config.toml), então o repo
# é a única fonte dele por enquanto.

# Gerado pelo install.sh com `herdr completion fish`
fish/completions/herdr.fish

# Estado volátil / logs
nvim/.nvimlog
nvim/nvim.log
*.log
herdr/session.json
herdr/session-snapshots/
herdr/.plugins.lock

# Estado do shell: histórico de $PATH universal e cores do fish.
# Muda sozinho a cada sessão. Descomente se preferir não versionar --
# seu tema do fish já está fixado em fish/conf.d/fish_frozen_theme.fish.
#fish/fish_variables

# Plugins do Noctalia
noctalia/plugins/
noctalia/colorschemes/

# Lixo de sistema/editor
.DS_Store
*.swp
*~
